---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const activites = (await getCollection("activites")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<PageLayout
  title="Missions & événements"
  rubrique="Rubrique V — Journal d'activités"
  description="Journal des missions, formations et événements professionnels."
>
  <div class="card-grid">
    {activites.map((act) => (
      <div class="pub-card">
        <div class="pub-meta">
          {act.data.date.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}{act.data.lieu ? ` · ${act.data.lieu}` : ""}
        </div>
        <h3>{act.data.titre}</h3>
        <p>{act.data.description}</p>
        <span class="pub-link">Lire l'entrée →</span>
      </div>
    ))}
  </div>
  {activites.length === 0 && <p style="color:var(--text-soft);">Aucune activité enregistrée pour le moment.</p>}
</PageLayout>
