---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const items = await getCollection("galerie");
---
<PageLayout
  title="Photos & moments professionnels"
  rubrique="Rubrique VI — Galerie"
  description="Photos et vidéos des activités professionnelles."
>
  <div class="gallery-grid">
    {items.map((item) => (
      <div class="gallery-item">
        <span class="ph" set:html={item.data.titre.replace(" — ", "<br />— ")} />
      </div>
    ))}
  </div>
  {items.length === 0 && <p style="color:var(--text-soft);">Aucun média pour le moment.</p>}
</PageLayout>
