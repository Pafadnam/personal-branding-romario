---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const experiences = (await getCollection("experiences")).sort(
  (a, b) => a.data.ordre - b.data.ordre
);
const formations = (await getCollection("formations")).sort(
  (a, b) => a.data.ordre - b.data.ordre
);

const competences = [
  { titre: "Droit douanier", detail: "Maîtrise du Code des douanes et des accords régionaux (UEMOA, CEDEAO)." },
  { titre: "Conseil juridique", detail: "Analyse de textes, rédaction d'avis et sécurisation des procédures." },
  { titre: "Contrôle & conformité", detail: "Vérification des déclarations et lutte contre la fraude commerciale." },
  { titre: "Relation aux usagers", detail: "Accueil, médiation et pédagogie auprès des opérateurs économiques." },
];
---
<PageLayout
  title="Curriculum Vitae"
  eyebrow="02 — Parcours"
  description="Parcours professionnel et formations."
>
  <div class="mb-10 flex justify-end">
    <a
      href="/cv/cv.pdf"
      class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-gold)] px-6 py-3 text-[13px] font-medium text-[color:var(--color-ink)] transition-transform hover:-translate-y-0.5"
    >
      Télécharger en PDF ↓
    </a>
  </div>

  <div class="grid gap-16 lg:grid-cols-2">
    <!-- Expériences -->
    <section class="reveal">
      <h2 class="font-display text-2xl text-[color:var(--color-text)]">Expériences</h2>
      <ol class="mt-8 space-y-8 border-l border-[color:var(--color-line)] pl-6">
        {experiences.map((exp) => (
          <li class="relative">
            <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full bg-[color:var(--color-gold)]"></span>
            <p class="font-mono text-xs text-[color:var(--color-text-dim)]">
              {exp.data.dateFin ? `${exp.data.dateDebut} — ${exp.data.dateFin}` : exp.data.dateDebut}
            </p>
            <h3 class="font-display mt-1 text-xl text-[color:var(--color-text)]">{exp.data.poste}</h3>
            <p class="text-[14px] text-[color:var(--color-gold-dim)]">
              {exp.data.structure}{exp.data.lieu ? ` · ${exp.data.lieu}` : ""}
            </p>
            <p class="mt-2 text-[14px] leading-relaxed text-[color:var(--color-text-dim)]">
              {exp.body}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Formations -->
    <section class="reveal">
      <h2 class="font-display text-2xl text-[color:var(--color-text)]">Formations</h2>
      <ol class="mt-8 space-y-8 border-l border-[color:var(--color-line)] pl-6">
        {formations.map((f) => (
          <li class="relative">
            <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full bg-[color:var(--color-gold)]"></span>
            <p class="font-mono text-xs text-[color:var(--color-text-dim)]">{f.data.annee}</p>
            <h3 class="font-display mt-1 text-xl text-[color:var(--color-text)]">{f.data.diplome}</h3>
            <p class="text-[14px] text-[color:var(--color-gold-dim)]">{f.data.etablissement}</p>
            <p class="mt-2 text-[14px] leading-relaxed text-[color:var(--color-text-dim)]">
              {f.body}
            </p>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <section class="reveal mt-20">
    <h2 class="font-display text-2xl text-[color:var(--color-text)]">Compétences</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {competences.map((c, i) => (
        <div class="rounded-xl border border-[color:var(--color-line)] p-6">
          <span class="font-mono text-xs text-[color:var(--color-gold)]">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-3 font-display text-lg text-[color:var(--color-text)]">{c.titre}</p>
          <p class="mt-2 text-[13px] leading-relaxed text-[color:var(--color-text-dim)]">{c.detail}</p>
        </div>
      ))}
    </div>
  </section>
</PageLayout>
