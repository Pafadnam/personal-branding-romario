---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import CarteIdentite from "../components/CarteIdentite.astro";
import profile from "../data/profile.json";
---
<BaseLayout>
  <Navigation />

  <header class="hero">
    <div class="hero-content">
      <div class="portrait-crossfade" role="img" aria-label={`Photo de ${profile.nom}, ${profile.profession}`}>
        FR
      </div>
      <h1 class="title">{profile.sousTitre.split(" ")[0]} Romario <em>Tiendrebeogo</em></h1>
      <p class="role-line">
        {profile.profession} — Direction Générale des Douanes du Burkina Faso.
        Conseiller juridique et fonctionnaire de douane au service de l'État.
      </p>
      <p class="slogan">« {profile.slogan} »</p>
      <div class="hero-cta">
        <a href="/#contact" class="btn btn-primary">Prendre contact</a>
        <a href="/cv" class="btn btn-ghost">Voir le CV</a>
      </div>
    </div>
  </header>

  <main class="panels">
    <section class="panel" id="profil">
      <div class="panel-inner profil-grid">
        <CarteIdentite />
        <div class="bio">
          <p class="rubrique">Rubrique I — Profil</p>
          <h2 class="panel-title">Un service public exercé avec rigueur</h2>
          <p>
            Inspecteur des Douanes au sein de la Direction Générale des Douanes
            du Burkina Faso, Franck Romario Tiendrebeogo conjugue expertise
            juridique et exigence de terrain au service de la souveraineté
            économique nationale.
          </p>
          <p>
            Conseiller juridique de formation, il apporte à la fonction
            douanière une lecture rigoureuse des textes et une attention
            constante à l'application équitable de la règle de droit — dans le
            respect des personnes, des échanges et de l'État.
          </p>
          <div class="tag-row">
            {profile.expertises.map((exp) => <span class="tag">{exp}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="panel" id="contact" style="padding-top:0;">
      <div class="panel-inner">
        <p class="rubrique">Rubrique VII — Contact</p>
        <h2 class="panel-title">Échanger avec Franck Romario</h2>
        <div class="contact-grid">
          <div>
            <ul class="contact-list">
              <li><span>EMAIL</span><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
              <li><span>LINKEDIN</span><a href={profile.linkedin} target="_blank" rel="noopener">{profile.linkedin.replace("https://", "")}</a></li>
              {profile.telephones.map((tel, i) => (
                <li><span>TÉLÉPHONE {i + 1}</span><a href={`tel:+226${tel.replace(/\s/g, "")}`}>{tel}</a></li>
              ))}
              <li><span>ADRESSE</span><span>{profile.adresse}</span></li>
            </ul>
          </div>
          <form class="form-box" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p style="position:absolute;left:-9999px;">
              <label>Ne pas remplir : <input name="bot-field" /></label>
            </p>
            <label for="nom">Nom complet</label>
            <input type="text" id="nom" name="name" placeholder="Votre nom" required />
            <label for="email">Adresse e-mail</label>
            <input type="email" id="email" name="email" placeholder="vous@exemple.com" required />
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Votre message" required></textarea>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
              Envoyer le message
            </button>
          </form>
        </div>

        <div class="faq-list">
          <p class="subhead">Questions fréquentes</p>
          <details class="faq-item">
            <summary>Comment puis-je vous contacter pour une demande officielle ?</summary>
            <p>Utilisez le formulaire ci-dessus, ou l'un des numéros et l'adresse e-mail indiqués.</p>
          </details>
          <details class="faq-item">
            <summary>Le CV est-il téléchargeable ?</summary>
            <p>Oui, une version PDF complète est disponible dans la rubrique Parcours, mise à jour à chaque modification.</p>
          </details>
          <details class="faq-item">
            <summary>Les publications sont-elles mises à jour régulièrement ?</summary>
            <p>Les articles, communiqués et rapports sont ajoutés dès leur disponibilité.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    © {new Date().getFullYear()} {profile.nom} · Site professionnel
  </footer>
</BaseLayout>
