---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const distinctions = await getCollection("distinctions");
const temoignages = await getCollection("temoignages");

const typeLabel: Record<string, string> = {
  certification: "Certification",
  distinction: "Distinction",
  formation: "Formation",
};
---
<PageLayout
  title="Reconnaissances professionnelles"
  rubrique="Rubrique III — Distinctions & certifications"
  description="Certifications, distinctions et témoignages."
>
  <div class="badge-row">
    {distinctions.map((d) => (
      <div class="badge">
        <div class="badge-cat">{typeLabel[d.data.type]}</div>
        <h4>{d.data.titre}</h4>
        <p>{d.body}</p>
      </div>
    ))}
  </div>

  {temoignages.length > 0 && (
    <>
      <p class="subhead">Témoignages</p>
      {temoignages.map((t) => (
        <div class="quote-block">
          <p class="quote">« {t.data.citation} »</p>
          <p class="quote-src">{t.data.auteur}{t.data.fonction ? ` — ${t.data.fonction}` : ""}</p>
        </div>
      ))}
    </>
  )}
</PageLayout>
