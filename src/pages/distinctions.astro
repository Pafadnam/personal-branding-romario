---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const distinctions = await getCollection("distinctions");
const temoignages = await getCollection("temoignages");

const typeLabel: Record<string, string> = {
  certification: "Certification",
  distinction: "Distinction",
  formation: "Formation",
};
---
<PageLayout
  title="Distinctions"
  eyebrow="03 — Reconnaissances professionnelles"
  description="Certifications, distinctions et témoignages."
>
  <div class="grid gap-4 sm:grid-cols-3">
    {distinctions.map((d) => (
      <div class="reveal rounded-xl border border-[color:var(--color-line)] p-6">
        <span class="rounded-full border border-[color:var(--color-gold-dim)] px-3 py-1 text-[11px] uppercase tracking-wide text-[color:var(--color-gold)]">
          {typeLabel[d.data.type]}
        </span>
        <p class="mt-4 font-display text-lg text-[color:var(--color-text)]">{d.data.titre}</p>
      </div>
    ))}
  </div>

  {temoignages.length > 0 && (
    <section class="mt-20">
      <h2 class="font-display text-2xl text-[color:var(--color-text)]">Témoignages</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {temoignages.map((t) => (
          <blockquote class="reveal border-l-2 border-[color:var(--color-gold)] pl-6">
            <p class="font-display text-lg italic leading-snug text-[color:var(--color-text-dim)]">
              « {t.data.citation} »
            </p>
            <footer class="mt-3 text-[13px] text-[color:var(--color-text-dim)]">
              — {t.data.auteur}{t.data.fonction ? `, ${t.data.fonction}` : ""}
            </footer>
          </blockquote>
        ))}
      </div>
    </section>
  )}
</PageLayout>
