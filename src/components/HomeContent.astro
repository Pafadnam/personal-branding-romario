---
import CarteIdentite from "./CarteIdentite.astro";
import Icon from "./Icon.astro";
import PhotoCarousel from "./PhotoCarousel.astro";
import profile from "../data/profile.json";
import { useTranslations, expertises, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);
const contactHref = lang === "fr" ? "/contact" : "/en/contact";
const cvHref = lang === "fr" ? "/cv" : "/en/cv";

const heroSlides = profile.carrousel.map((item) => ({ src: item.url, alt: item.legende }));
---
<header class="hero">
  <div class="hero-content">
    <PhotoCarousel slides={heroSlides} />
    <h1 class="title">{profile.nomAffichage}</h1>
    <p class="role-line">{lang === "fr" ? profile.titreProfessionnel : t("hero.role")}</p>
    <p class="slogan">« {lang === "fr" ? profile.slogan : t("hero.slogan")} »</p>
    <div class="hero-cta">
      <a href={contactHref} class="btn btn-primary"><Icon name="send" />{t("hero.ctaContact")}</a>
      <a href={cvHref} class="btn btn-ghost">{t("hero.ctaCv")}<Icon name="arrow-right" /></a>
    </div>
  </div>
</header>

<main class="panels">
  <section class="panel" id="profil">
    <div class="panel-inner profil-grid">
      <CarteIdentite />
      <div class="bio">
        <h2 class="panel-title">{t("profil.title")}</h2>
        <p>{t("profil.p1")}</p>
        <p>{t("profil.p2")}</p>
        <div class="tag-row">
          {expertises[lang].map((exp) => <span class="tag">{exp}</span>)}
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  © {new Date().getFullYear()} {profile.nom} · {t("footer.text")}
</footer>
