---
import CarteIdentite from "./CarteIdentite.astro";
import Icon from "./Icon.astro";
import PhotoCarousel from "./PhotoCarousel.astro";
import profile from "../data/profile.json";
import { useTranslations, expertises, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);
const contactHref = lang === "fr" ? "/contact" : "/en/contact";
const cvHref = lang === "fr" ? "/cv" : "/en/cv";

const heroSlides =
  lang === "fr"
    ? [
        { src: "/images/portrait-uniforme.jpg", alt: "Portrait officiel en uniforme" },
        { src: "/images/portrait-civil.jpg", alt: "Portrait en tenue civile" },
        { src: "/images/soutenance-1.jpg", alt: "Soutenance de Master en Droit — 21 juillet 2026" },
        { src: "/images/soutenance-2.jpg", alt: "Remise du diplôme — Master en Droit" },
      ]
    : [
        { src: "/images/portrait-uniforme.jpg", alt: "Official portrait in uniform" },
        { src: "/images/portrait-civil.jpg", alt: "Portrait in civilian attire" },
        { src: "/images/soutenance-1.jpg", alt: "Master's Degree in Law defence — 21 July 2026" },
        { src: "/images/soutenance-2.jpg", alt: "Diploma ceremony — Master's Degree in Law" },
      ];
---
<header class="hero">
  <div class="hero-content">
    <PhotoCarousel slides={heroSlides} />
    <h1 class="title">{t("hero.title")}</h1>
    <p class="role-line">{t("hero.role")}</p>
    <p class="slogan">« {t("hero.slogan")} »</p>
    <div class="hero-cta">
      <a href={contactHref} class="btn btn-primary"><Icon name="send" />{t("hero.ctaContact")}</a>
      <a href={cvHref} class="btn btn-ghost">{t("hero.ctaCv")}<Icon name="arrow-right" /></a>
    </div>
  </div>
</header>

<main class="panels">
  <section class="panel" id="profil">
    <div class="panel-inner profil-grid">
      <CarteIdentite />
      <div class="bio">
        <h2 class="panel-title">{t("profil.title")}</h2>
        <p>{t("profil.p1")}</p>
        <p>{t("profil.p2")}</p>
        <div class="tag-row">
          {expertises[lang].map((exp) => <span class="tag">{exp}</span>)}
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  © {new Date().getFullYear()} {profile.nom} · {t("footer.text")}
</footer>
