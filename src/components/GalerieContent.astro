---
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);

const items = (await getCollection("galerie")).sort((a, b) => {
  const da = a.data.date?.valueOf() ?? 0;
  const db = b.data.date?.valueOf() ?? 0;
  return db - da;
});
const locale = lang === "fr" ? "fr-FR" : "en-GB";
---
{items.length > 0 ? (
  <div class="gallery-grid">
    {items.map((item) => {
      const isPlaceholder = item.data.url.includes("placeholder-");
      const [line1, line2] = item.data.titre.split(" — ");
      return (
        <figure class="gallery-item">
          <div class="gallery-photo">
            {isPlaceholder ? (
              <div class="ph-wrap">
                <Icon name={item.data.type === "video" ? "video" : "image"} class="icon icon-lg" />
                <span class="ph">
                  {line1}
                  {line2 && <><br />— {line2}</>}
                </span>
              </div>
            ) : (
              <img src={item.data.url} alt={item.data.titre} loading="lazy" />
            )}
          </div>
          <figcaption class="gallery-caption">
            <span class="gallery-caption-title">{item.data.titre}</span>
            {(item.data.album || item.data.date) && (
              <span class="gallery-caption-meta">
                {item.data.album}
                {item.data.album && item.data.date && " · "}
                {item.data.date && item.data.date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" })}
              </span>
            )}
          </figcaption>
        </figure>
      );
    })}
  </div>
) : (
  <p style="color:var(--text-soft);">{t("galerie.empty")}</p>
)}
