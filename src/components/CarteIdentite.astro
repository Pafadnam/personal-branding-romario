---
import profile from "../data/profile.json";
---
<div class="id-card">
  <div class="id-card-label">CARTE PROFESSIONNELLE</div>
  <div class="id-photo">
    <img src={profile.photoCarteIdentite} alt={`Photo de ${profile.nom}`} />
  </div>
  <div class="id-name">Kiswend-Sida Franck Romario TIENDREBEOGO</div>
  <div class="id-role">{profile.profession}</div>
  <div class="id-row"><span>Nationalité</span><span>{profile.nationalite}</span></div>
  <div class="id-row"><span>Résidence</span><span>{profile.residence}</span></div>
  <div class="id-row"><span>Statut</span><span>{profile.statut}</span></div>
</div>
