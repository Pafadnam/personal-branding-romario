---
import profile from "../data/profile.json";
---
<div class="relative mx-auto w-full max-w-sm">
  <!-- Halo doré, ambiance -->
  <div class="gold-glow pointer-events-none absolute -inset-16"></div>

  <div class="paper-grain relative overflow-hidden rounded-xl border border-black/5 bg-[color:var(--color-paper)] text-[color:var(--color-text-onPaper)] shadow-[0_30px_60px_-15px_rgba(0,0,0,0.5)]">
    <!-- Liseré doré supérieur -->
    <div class="h-1 w-full bg-[color:var(--color-gold)]"></div>

    <div class="p-7">
      <!-- En-tête -->
      <div class="flex items-start justify-between">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-black/40">
            République du Burkina Faso
          </p>
          <p class="mt-0.5 font-display text-[15px] italic text-black/70">
            Direction Générale des Douanes
          </p>
        </div>
        <span class="font-mono text-[10px] text-black/35">{profile.matricule}</span>
      </div>

      <!-- Identité -->
      <div class="mt-6 flex items-center gap-4">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-ink)] text-[9px] uppercase tracking-wide text-white/40">
          Photo
        </div>
        <div class="min-w-0">
          <h1 class="font-display text-xl leading-tight">{profile.nom}</h1>
          <p class="mt-1 text-[13px] font-medium text-[color:var(--color-gold-dim)]">
            {profile.profession} · {profile.sousTitre}
          </p>
        </div>
      </div>

      <!-- Devise -->
      <p class="mt-6 font-display text-[15px] italic leading-snug text-black/60">
        « {profile.slogan} »
      </p>

      <!-- Pied -->
      <div class="mt-6 flex items-end justify-between border-t border-black/10 pt-4">
        <div class="font-mono text-[10px] leading-relaxed text-black/40">
          <p>{profile.email}</p>
          <p>{profile.adresse}</p>
        </div>
        <div class="grid h-10 w-10 shrink-0 grid-cols-3 gap-px rounded-sm bg-black/70 p-1">
          {Array.from({ length: 9 }).map((_, i) => (
            <span class:list={["h-full w-full", (i + Math.floor(i / 3)) % 2 === 0 ? "bg-white" : "bg-black/70"]}></span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <p class="mt-4 text-center font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-dim)]">
    Identité numérique vérifiable
  </p>
</div>
