---
import profile from "../data/profile.json";
---
<div class="id-card">
  <div class="id-card-label">CARTE PROFESSIONNELLE</div>
  <div class="id-photo">
    <img src="/images/portrait-uniforme.jpg" alt={`Photo de ${profile.nom}`} />
  </div>
  <div class="id-name">F. Romario Tiendrebeogo</div>
  <div class="id-role">{profile.profession}</div>
  <div class="id-row"><span>Nationalité</span><span>{profile.nationalite}</span></div>
  <div class="id-row"><span>Résidence</span><span>{profile.residence}</span></div>
  <div class="id-row"><span>Statut</span><span>{profile.statut}</span></div>
  <div class="qr-box">
    <div class="qr-mini" role="img" aria-label="QR code d'accès à la carte numérique">QR<br />CODE</div>
    <div class="qr-mini-txt">Scanner pour accéder<br />à la carte numérique</div>
  </div>
</div>
