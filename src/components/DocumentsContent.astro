---
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);

const docs = await getCollection("documents");
const typeIcon: Record<string, string> = { pdf: "PDF", word: "DOC", excel: "XLS", zip: "ZIP" };
---
<ul class="doc-list">
  {docs.map((doc) => (
    <li>
      <div style="display:flex;align-items:center;gap:16px;">
        <span class="doc-icon">{typeIcon[doc.data.type]}</span>
        <div>
          <p class="doc-title">{doc.data.titre}</p>
          {doc.data.categorie && <p class="doc-cat">{doc.data.categorie}</p>}
        </div>
      </div>
      <a href={doc.data.fichier} class="doc-dl"><Icon name="download" class="icon icon-sm" />{t("documents.download")}</a>
    </li>
  ))}
</ul>
{docs.length === 0 && <p style="color:var(--text-soft);">{t("documents.empty")}</p>}
