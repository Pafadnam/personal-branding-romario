---
import BaseLayout from "./BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import profile from "../data/profile.json";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = "fr" } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout title={`${title} — ${profile.nom}`} description={description} lang={lang}>
  <Navigation lang={lang} />

  <main class="panels">
    <section class="panel">
      <div class="panel-inner">
        <h2 class="panel-title">{title}</h2>
        <slot />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    © {new Date().getFullYear()} {profile.nom} · <a href={lang === "fr" ? "/documents" : "/en/documents"}>{t("footer.documents")}</a>
  </footer>
</BaseLayout>
